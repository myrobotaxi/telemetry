{
  "server": {
    "tesla_port": 443,
    "client_port": 8080,
    "metrics_port": 9090
  },
  "tls": {
    "cert_file": "/certs/server.crt",
    "key_file": "/certs/server.key",
    "ca_file": "/certs/tesla-ca.pem"
  },
  "database": {
    "max_conns": 20,
    "min_conns": 5
  },
  "telemetry": {
    "max_vehicles": 100,
    "event_buffer_size": 1000,
    "batch_write_interval": "60s",
    "batch_write_size": 100
  },
  "drives": {
    "min_duration": "2m",
    "min_distance_miles": 0.1,
    "end_debounce": "30s",
    "geocode_timeout": "5s",
    "stall_timeout": "15m",
    "max_drive_duration": "12h"
  },
  "websocket": {
    "heartbeat_interval": "15s",
    "write_timeout": "10s",
    "max_connections_per_user": 5,
    "read_limit": 4096
  },
  "auth": {
    "token_issuer": "myrobotaxi",
    "token_audience": "telemetry"
  },
  "proxy": {
    "url": "https://localhost:4443",
    "fleet_telemetry_hostname": "telemetry.myrobotaxi.app",
    "fleet_telemetry_port": 443
  }
}
